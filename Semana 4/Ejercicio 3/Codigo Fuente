object Main {

  def main(args: Array[String]): Unit = {
    val productos = Map(
      "Laptop"  -> 1200.0,
      "Mouse"   -> 25.0,
      "Monitor" -> 350.0,
      "Teclado" -> 80.0,
      "USB"     -> 15.0
    )

    val filtrados = productos
      .filter({ case (_, precio) => precio > 50.0 })            // Solo > 50
      .map({ case (nombre, precio) => (nombre, precio * 0.8) }) // Descuento 20%

    // Lista con el formato pedido
    val lista = filtrados.map({ case (nombre, precio) =>
      "Producto: " + nombre + " | Precio Rebajado: $" + precio
    })

    // Imprimir cada producto 
    lista.foreach(println)

    // Precio promedio
    val promedio = filtrados.values.sum / filtrados.size
    println("Precio promedio: " + promedio)
  }
}
