object Main {

  def main(args: Array[String]): Unit = {
    val etiquetas = Set(
      "  Scala  ",
      "scala",
      "Java",
      "  FP  ",
      "utp",
      "Utepinos",
      "  "
    )

    val resultado = etiquetas
      .map(_.trim)                                // 1. Quitar espacios
      .map(_.toLowerCase)                         // 2. Pasar a minúsculas
      .filter(_.length >= 3)                      // 3. Filtrar inválidas
      .mkString(",")                              // 4. Unir con comas

    println(resultado)
  }
}
