object Main {

  case class Libro(titulo: String, autor: String, paginas: Int)

  def main(args: Array[String]): Unit = {
    val libros = List(
      Libro("El Principito", "Antoine", 96),
      Libro("Cien años de soledad", "García Márquez", 471),
      Libro("Rebelion en la granja", "Orwell", 144),
      Libro("1984", "Orwell", 328)
    )

    val procesados = libros
      .filter(_.paginas < 200)                    // Filtrar libros cortos
      .map(_.titulo.toUpperCase)                  // Títulos en mayúsculas
      .map(t => "LECTURA CORTA: " + t)            // Agregar prefijo

    // Imprimir cada título procesado
    procesados.foreach(println)

    // Total de caracteres de todos los títulos combinados
    val totalCaracteres = procesados.mkString("").length
    println("Total de caracteres: " + totalCaracteres)
  }
}
